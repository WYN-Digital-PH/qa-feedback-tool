# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Branding (white-labeling)
#
# All optional — each falls back to the default in src/config/brand.ts.
# Colours, fonts and radii are NOT set here: they live as CSS custom properties
# in the BRAND block at the top of src/index.css. See docs/WHITE_LABELING.md.
# ---------------------------------------------------------------------------

# Product name shown in the sidebar, on auth screens and in the tab title.
VITE_BRAND_PRODUCT_NAME=

# The agency operating the tool. Appears as "by <company>" and as the workspace.
VITE_BRAND_COMPANY_NAME=

# One-line description used for the meta description and link previews.
VITE_BRAND_DESCRIPTION=

# Absolute URL to a hosted logo. Leave blank to use the bundled
# src/assets/logo.jpg instead.
VITE_BRAND_LOGO_URL=

# Public marketing site for the agency, if you want to link out to it.
VITE_BRAND_WEBSITE_URL=
